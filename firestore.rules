rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'mehmetalipolat20.05@gmail.com';
    }
    function memberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function mem() { return get(memberPath()).data; }
    // Hesabın görebildiği daireler: tek daire hesabında [unit], grup hesabında units listesi
    function myUnits() {
      return signedIn() && exists(memberPath()) && mem().active != false
        ? (('units' in mem()) && mem().units.size() > 0 ? mem().units : [mem().unit]) : [];
    }

    // Genel ayarlar (site adı, IBAN, duyurular, aidat tutarı): giriş yapan herkes okur, yalnızca yönetici yazar
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Sakinlere gösterilen isimsiz site özeti
    match /summary/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Daire bilgileri: sakin yalnızca kendi dairesini okur
    match /units/{kod} {
      allow read: if isAdmin() || kod in myUnits();
      allow write: if isAdmin();
    }

    // Ödeme ve borç hareketleri: sakin yalnızca kendi dairesininkileri okur
    match /ledger/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.unit in myUnits());
      allow write: if isAdmin();
    }

    // Gider kayıtlarının ayrıntısı yalnızca yönetici içindir (sakinler özeti görür)
    match /exp/{id} {
      allow read, write: if isAdmin();
    }

    // Sakin hesapları: sakin yalnızca kendi kaydını okur; şifresini değiştirince ilk şifreyi silebilir
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pwChanged', 'initialPassword'])
            && request.resource.data.initialPassword == null);
    }


    // Sakinin ödeme bildirimi: kendi dairesi için oluşturur, yönetici onaylar
    match /notices/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.unit in myUnits());
      allow create: if signedIn()
        && request.resource.data.unit in myUnits()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'bekliyor'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount < 1000000;
      allow update, delete: if isAdmin();
    }

    // Arıza / talep: sakin kendi dairesi için açar, yönetici yanıtlar
    match /requests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.unit in myUnits());
      allow create: if signedIn()
        && request.resource.data.unit in myUnits()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'acik'
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500;
      allow update, delete: if isAdmin();
    }

    // Anketler: herkes görür, yönetici yönetir; her daire tek oy (oy belgesinin adı daire kodu)
    match /polls/{pollId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /votes/{kod} {
        allow read: if isAdmin() || (signedIn() && kod in myUnits());
        allow create, update: if signedIn() && kod in myUnits()
          && get(/databases/$(database)/documents/polls/$(pollId)).data.open == true
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.option is int && request.resource.data.option >= 0 && request.resource.data.option < 10;
        allow delete: if isAdmin();
      }
    }

    // Diğer her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
